                <can_authorize>1</can_authorize>
                <can_capture>1</can_capture>
                <can_use_checkout>1</can_use_checkout>
            </epayepicpayment>
            <epayepicpayment_anyday>
                <active>0</active>
                <model>Epay\Magento2EpicPaymentModule\Model\AnydayPaymentMethod</model>
